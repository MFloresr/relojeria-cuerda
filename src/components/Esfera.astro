---
// Esfera de reloj con la hora real. El segundero barre de forma continua; con "reducir movimiento" salta cada segundo.
const indices = Array.from({ length: 60 }, (_, i) => i);
const numeros = [12, 3, 6, 9];
---

<div class="esfera" role="img" aria-label="Reloj de esfera con la hora actual">
  <svg viewBox="-260 -260 520 520" aria-hidden="true" focusable="false">
    <circle class="esfera__caja" r="252" />
    <circle class="esfera__fondo" r="232" />
    {indices.map((i) => {
      const grande = i % 5 === 0;
      return <line class="esfera__indice" x1="0" y1={-(grande ? 190 : 206)} x2="0" y2="-222" stroke-width={grande ? 6 : 2} transform={`rotate(${i * 6})`} />;
    })}
    {numeros.map((n) => {
      const a = ((n % 12) * 30 * Math.PI) / 180;
      return <text class="esfera__num" x={Math.sin(a) * 150} y={-Math.cos(a) * 150}>{n}</text>;
    })}
    <text class="esfera__marca" x="0" y="-78">CUERDA</text>
    <g id="mano-hora"><line class="esfera__mano" x1="0" y1="14" x2="0" y2="-108" stroke="#14274a" stroke-width="12" /><line class="esfera__mano" x1="0" y1="-40" x2="0" y2="-96" stroke="#bde86b" stroke-width="4" /></g>
    <g id="mano-minuto"><line class="esfera__mano" x1="0" y1="18" x2="0" y2="-170" stroke="#14274a" stroke-width="8" /><line class="esfera__mano" x1="0" y1="-50" x2="0" y2="-156" stroke="#bde86b" stroke-width="3" /></g>
    <g id="mano-segundo"><line class="esfera__mano" x1="0" y1="48" x2="0" y2="-196" stroke="#d93a2e" stroke-width="3" /><circle r="9" fill="#d93a2e" cy="40" /></g>
    <circle r="7" fill="#14274a" /><circle r="3" fill="#f4f6f8" />
  </svg>
</div>

<script>
  const hora = document.getElementById('mano-hora');
  const minuto = document.getElementById('mano-minuto');
  const segundo = document.getElementById('mano-segundo');
  if (hora && minuto && segundo) {
    const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');
    const formato = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
    const pintar = () => {
      const ahora = new Date();
      const p = Object.fromEntries(formato.formatToParts(ahora).map((x) => [x.type, Number(x.value)]));
      const s = p.second + (reducir.matches ? 0 : ahora.getMilliseconds() / 1000);
      const m = p.minute + s / 60;
      const h = (p.hour % 12) + m / 60;
      segundo.setAttribute('transform', `rotate(${s * 6})`);
      minuto.setAttribute('transform', `rotate(${m * 6})`);
      hora.setAttribute('transform', `rotate(${h * 30})`);
    };
    const bucle = () => { pintar(); if (reducir.matches) setTimeout(bucle, 1000 - (Date.now() % 1000)); else requestAnimationFrame(bucle); };
    bucle();
  }
</script>
