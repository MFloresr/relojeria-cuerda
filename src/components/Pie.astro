---
import { menu, sitio } from '../lib/sitio';
const { direccion: d } = sitio;
---

<footer class="pie">
  <div class="pie__aviso">Web de demostración: los datos, los relojes y las opiniones son de ejemplo. No se cobra ningún pedido.</div>
  <div class="contenedor pie__contenido">
    <div class="pie__rejilla">
      <div>
        <a class="logo" href="/" style="color:#fff" translate="no"><span class="logo__punto" aria-hidden="true"></span>Cuerda<span class="solo-lectores"> Relojería, ir al inicio</span></a>
        <p style="margin-top:14px;max-width:32ch">{sitio.eslogan}.</p>
        <p>{d.calle}<br />{d.cp} {d.ciudad} ({d.provincia})</p>
      </div>
      <div>
        <h2>Contacto</h2>
        <ul>
          <li><a href={`tel:${sitio.telefono}`}>{sitio.telefonoVisible}</a></li>
          <li><a href={`mailto:${sitio.email}`}>{sitio.email}</a></li>
          <li><a href={`https://wa.me/${sitio.whatsapp}`}>WhatsApp</a></li>
          <li><a href="/contacto/">Cómo llegar</a></li>
        </ul>
      </div>
      <div>
        <h2>Horario de tienda</h2>
        <ul>
          {sitio.horarios.map((h) => (
            <li><strong>{h.etiqueta}</strong><br />{h.tramos.length ? h.tramos.map((t) => `${t.abre} a ${t.cierra}`).join(' y ') : 'Cerrado'}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Comprar</h2>
        <ul>
          {menu.map((m) => <li><a href={m.href}>{m.texto}</a></li>)}
          <li><a href="/envios-y-devoluciones/">Envíos y devoluciones</a></li>
          <li><a href="/garantia/">Garantía</a></li>
          <li><a href="/nosotros/">Quiénes somos</a></li>
        </ul>
      </div>
    </div>
    <div class="pie__bajo">
      <span>© {new Date().getFullYear()} {sitio.nombre}</span>
      <span>
        <a href="/aviso-legal/">Aviso legal</a> · <a href="/condiciones-de-venta/">Condiciones de venta</a> · <a href="/privacidad/">Privacidad</a> · <a href="/cookies/">Cookies</a> · <a href="/creditos/">Créditos de las fotos</a>
      </span>
    </div>
  </div>
</footer>
